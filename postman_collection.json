    {
      "name": "Events",
      "item": [
        {
          "name": "Submeter evento",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/events",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "events"
              ],
              "variable": []
            },
            "description": "Ponto central de entrada para qualquer operação normalizada Wede.\n\nO payload é independente do canal de transporte — a Wede decide\nautomaticamente como encaminhar com base no estado de conectividade\nactual da zona do tenant.\n\n**Tipos de evento suportados em Phase 1:**\n- `EMERGENCY` — emergência médica, incidente técnico, falha de rede\n- `PAYMENT` — pagamento offline, wallet fallback, microfinança\n- `BOOKING` — agendamento de consulta, serviço, recurso\n- `STATUS_UPDATE` — actualização de estado de recurso ou operador\n- `IDENTITY_CONFIRM` — confirmação de identidade em rede degradada\n- `DISPATCH` — despacho de equipa ou recurso de campo\n\nCada evento recebe um `event_id` imutável que persiste através de\ntodos os canais e sincronizações.\n",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Listar eventos do tenant",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/events",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "events"
              ],
              "variable": []
            },
            "description": "Retorna eventos do tenant com filtragem por estado, tipo, vertical e zona.\nPaginação por cursor para suportar volumes elevados.\n"
          }
        },
        {
          "name": "Consultar estado de um evento",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/events/:event_id",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "events",
                ":event_id"
              ],
              "variable": [
                {
                  "key": "event_id",
                  "value": "",
                  "description": "Path parameter"
                }
              ]
            },
            "description": "Retorna o estado actual e histórico de ciclo de vida de um evento específico.\nInclui o canal efectivamente usado para entrega e todas as tentativas de fallback.\n"
          }
        }
      ]
    },
    {
      "name": "Sync",
      "item": [
        {
          "name": "Sincronizar lote de eventos gerados offline",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/sync/batch",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sync",
                "batch"
              ],
              "variable": []
            },
            "description": "Endpoint de reconciliação para o SDK após retorno de conectividade.\n\nO SDK submete todos os eventos gerados localmente durante o período offline.\nA Wede executa:\n1. Validação de integridade (hash + assinatura por evento)\n2. Deduplicação por `idempotency_key`\n3. Resolução de conflitos por timestamp e regras do tenant\n4. Actualização do estado de cada evento no sistema central\n\nO lote é processado atomicamente por grupo de `idempotency_key`.\nEventos inválidos são rejeitados individualmente sem afectar o lote.\n",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Estado de sincronização do tenant",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/sync/status",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "sync",
                "status"
              ],
              "variable": []
            },
            "description": "Retorna métricas de sincronização: eventos pendentes, sincronizados,\nfalhados e em conflito. Útil para monitorização e alertas.\n"
          }
        }
      ]
    },
